<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds: HTTPS only, everywhere. The debug and profile builds
     override this file to also allow the local API used in development and CI
     (src/debug, src/profile), so a release build can never send an API key
     over plain HTTP (mobile-security-lab MS-02). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
