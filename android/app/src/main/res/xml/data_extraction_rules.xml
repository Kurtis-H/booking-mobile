<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: nothing goes into cloud backups or device-to-device
     transfers. allowBackup="false" covers older versions
     (mobile-security-lab MS-04). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
