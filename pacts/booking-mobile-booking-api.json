      "description": "a request for the first page of events",
      "pending": false,
      "providerStates": [
        {
          "name": "events exist"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/events",
        "query": {
          "limit": [
            "12"
          ],
          "offset": [
            "0"
          ]
        },
        "headers": {
          "Accept": [
            "application/json"
          ]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "content": {
            "items": [
              {
                "id": 1,
                "name": "Summer concert",
                "venue": "Main hall",
                "starts_at": "2027-06-01T19:00:00+00:00",
                "available_seats": 4
              }
            ],
            "total": 30
          },
          "contentType": "application/json",
          "encoded": false
        },
        "matchingRules": {
          "body": {
            "$.items": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
